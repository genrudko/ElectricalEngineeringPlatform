<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/FixtureModels.cs" Link="FixtureModels.cs" />
    <Compile Include="../src/P1Commands.cs" Link="P1Commands.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../shared/fixtures/p1-shell-fixture.json" Link="Fixtures/p1-shell-fixture.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../shared/fixtures/typography.txt" Link="Fixtures/typography.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
